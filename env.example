# NotionShelf Configuration
# Copy this file to .env and fill in your details

# Your Notion API token (get from https://www.notion.so/my-integrations)
NOTION_API_KEY=your_notion_api_key_here

# The ID of your Notion database where books will be added
NOTION_DATABASE_ID=your_database_id_here

# Path to the directory containing your EPUB files
EPUB_DIRECTORY_PATH=/path/to/your/epub/files

# Optional: Custom property names in your Notion database
# If not specified, defaults to "Title", "Author", and "Cover"
# NOTION_TITLE_PROPERTY=Title
# NOTION_AUTHOR_PROPERTY=Author
# NOTION_COVER_PROPERTY=Cover

# Optional: Delete EPUB files after adding to Notion
# Set to "false" to keep files after adding them to Notion
# Default: true (files are deleted after adding)
# DELETE_FILES_AFTER_ADDING=true